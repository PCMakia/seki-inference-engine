# Copy this file to .env and adjust values for your machine.
# Docker Compose reads this file and overrides in-cluster URLs in docker-compose.yml.

# --- Gateway ---
API_KEY=change-me
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL_NAME=nomic-embed-text
REQUEST_TIMEOUT=120
INFERENCE_HOST_PORT=9000
VLLM_HOST_PORT=9001
OLLAMA_HOST_PORT=9114
PORT=8000
LOG_LEVEL=INFO

# Local (uvicorn) defaults. Compose replaces these with service DNS names.
VLLM_BASE_URL=http://localhost:9001/v1
VLLM_API_KEY=EMPTY
OLLAMA_BASE_URL=http://localhost:9114/v1

# --- vLLM (only used with: docker compose --profile gpu up) ---
# Default 0.92 needs ~11 GiB free. Shared GPUs (old seki-ollama, desktop) fail
# that check. 0.70 fits Qwen2.5-3B when ~10.8 GiB is free.
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=4096
# Docker Desktop / WSL2: V2 runner needs this or it raises "UVA is not available".
VLLM_WSL2_ENABLE_PIN_MEMORY=1
HF_TOKEN=hf_xxx_your_token
HF_CACHE_PATH=D:/data/huggingface

# --- Ollama fallback models ---
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_DATA_PATH=D:/data/ollama-data
OLLAMA_PULL_MODELS=qwen2.5:3b,nomic-embed-text
