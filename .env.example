# Low_ends_6GB — Ubuntu server, RTX 1660 Ti (6 GB VRAM).
# Copy to .env. Do not commit secrets.
# This branch does not run vLLM.

# --- Gateway ---
API_KEY=change-me
EMBEDDING_MODEL_NAME=nomic-embed-text
REQUEST_TIMEOUT=120
INFERENCE_HOST_PORT=9000
OLLAMA_HOST_PORT=9114
PORT=8000
LOG_LEVEL=INFO

# Local (uvicorn) default. Compose replaces this with service DNS.
OLLAMA_BASE_URL=http://localhost:9114/v1

# --- Ollama (llama.cpp GGUF on the 1660 Ti) ---
OLLAMA_MODEL=qwen2.5:3b-instruct-q5_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_DATA_PATH=/var/lib/seki/ollama
OLLAMA_PULL_MODELS=qwen2.5:3b-instruct-q5_K_M,nomic-embed-text
# Unload weights after idle so VRAM is free for other work. Discord stays connected.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
