# Low_ends_6GB / dev-optimize — Ubuntu server, RTX 1660 Ti (6 GB VRAM).
# Copy to .env. Do not commit secrets.
# Speculative decoding: 3B target + 0.5B draft. This branch does not run vLLM.

# --- Gateway ---
API_KEY=change-me
EMBEDDING_MODEL_NAME=nomic-embed-text
REQUEST_TIMEOUT=300
INFERENCE_HOST_PORT=9000
OLLAMA_HOST_PORT=9114
PORT=8000
LOG_LEVEL=INFO

# Local (uvicorn) default. Compose replaces this with service DNS.
OLLAMA_BASE_URL=http://localhost:9114/v1

# --- Speculative pair (opt-in bench; OLLAMA_SPECULATIVE=1 to try Ollama DRAFT) ---
OLLAMA_SPECULATIVE=0
OLLAMA_TARGET_MODEL=qwen2.5:3b
OLLAMA_DRAFT_MODEL=qwen2.5:0.5b
OLLAMA_SPEC_MODEL=seki-qwen-spec
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=2048
OLLAMA_DRAFT_NUM_PREDICT=8

# --- llama.cpp overlay (./scripts/up_llamacpp.sh) — production uses target-only ---
LLAMA_TARGET_HOST_PORT=9082
LLAMA_SPEC_HOST_PORT=9081
LLAMA_SPEC_DRAFT_N_MAX=8
LLAMA_SPEC_DRAFT_P_MIN=0.75

# --- Ollama ---
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Relative path works on Windows Docker and Ubuntu. On the server you can also use /var/lib/seki/ollama.
OLLAMA_DATA_PATH=./data/ollama
OLLAMA_PULL_MODELS=qwen2.5:3b,qwen2.5:0.5b,nomic-embed-text
# Unload weights after idle so VRAM is free for other work. Discord stays connected.
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
